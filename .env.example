# Runtime
NODE_ENV=development
PORT=3000
# Base url para deep links en frontend, etc. Debe coincidir con el schema en front.
APP_BASE_URL=https://mirailink.xyz
# Confia solo en el proxy local que reenvia al proceso Node, por ejemplo un tunel.
TRUST_PROXY=loopback
ORIGIN=http://localhost:5173
# Expresion regular opcional para origenes adicionales permitidos (ej. tuneles Cloudflare, subdominios o puertos)
ORIGIN_REGEX=^https:\/\/(.*\.trycloudflare\.com|.*\.mirailink\.xyz)$
# Rate limiting global (generoso para navegacion habitual de la app)
GLOBAL_RATE_LIMIT_MAX=1000
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
DB_URL=postgres://postgres:replace_with_password@localhost:5432/mirailink
UPLOAD_MAX_BYTES=5242880
# Optional persistent directory outside the checkout in production (when STORAGE_DRIVER=local)
UPLOAD_ROOT=

# Storage driver: 'local' (filesystem) or 'r2' (Cloudflare R2 S3-compatible)
STORAGE_DRIVER=local
# Required if STORAGE_DRIVER=r2
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_URL=https://pub-yourbucket.r2.dev

# Authentication - generate unique random values, never copy these placeholders
JWT_SECRET=replace_with_at_least_32_random_characters
SALT_ROUNDS=12
SECRET_2FA_KEY=replace_with_exactly_64_random_hex_characters
# Required only while legacy AES-CBC secrets still exist
SECRET_2FA_IV=replace_with_exactly_32_random_hex_characters

# SMTP
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=noreply@example.com
EMAIL_PASSWORD=replace_with_provider_secret

# Firebase - optional, loaded only when push notifications are sent
FIREBASE_SERVICE_ACCOUNT_FILE_NAME=/absolute/path/to/firebase-service-account.json

# RAWG API
RAWG_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# SYNC CATALOG INTERVAL TIME
CATALOG_SYNC_INTERVAL_HOURS=24
# Enable new Crystal Capsule discovery after migration and catalog seed.
CRYSTAL_CAPSULE_ENABLED=false
# Enable new Affinities system.
AFFINITIES_ENABLED=false

# GOOGLE PLAY SERVICE ACCOUNT
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=google-play-service-account-example.json
