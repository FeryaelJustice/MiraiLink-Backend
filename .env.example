# HTTP
PORT=3000
ORIGIN=http://localhost:5173

# PostgreSQL
DB_URL=postgres://postgres:replace_with_password@localhost:5432/mirailink

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
SALT_ROUNDS=12

# SMTP
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=noreply@example.com
EMAIL_PASSWORD=replace_with_smtp_password

# 2FA encryption. Generate 32 bytes for the key and 16 bytes for the IV.
SECRET_2FA_KEY=replace_with_64_hex_characters
SECRET_2FA_IV=replace_with_32_hex_characters

# Firebase is currently loaded from src/serviceAccountKey.json.
