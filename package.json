{
    "name": "mirailink-backend",
    "version": "2.0.0",
    "description": "The official mirailink backend",
    "main": "./src/server.js",
    "scripts": {
        "dev": "cross-env NODE_ENV=development nodemon --env-file=.env src/server.js",
        "start": "cross-env NODE_ENV=production node --env-file=.env src/server.js",
        "build": "node --check src/server.js",
        "test": "vitest run",
        "lint": "eslint .",
        "test:unit": "vitest run tests/unit",
        "test:integration": "vitest run tests/integration",
        "test:database": "vitest run tests/database",
        "test:coverage": "vitest run --coverage",
        "lint:fix": "eslint . --fix",
        "check:routes": "node scripts/check-openapi-routes.js",
        "db:reset": "node scripts/reset-db.js",
        "db:migrate": "node scripts/migrate-db.js",
        "db:seed": "node scripts/import-geography.js && node scripts/seed.js",
        "check": "npm run lint && npm run test:coverage && npm run check:routes"
    },
    "keywords": [
        "mirailink",
        "backend",
        "chat",
        "database",
        "social-media"
    ],
    "author": "FeryaelJustice",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "adm-zip": "^0.6.1",
        "bcrypt": "^6.0.0",
        "compression": "^1.8.2",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.0",
        "firebase-admin": "^14.4.0",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.4.0",
        "nodemailer": "^10.0.10",
        "pg": "^8.23.0",
        "speakeasy": "^2.0.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@vitest/coverage-v8": "^5.0.1",
        "cross-env": "^10.1.0",
        "eslint": "^10.11.0",
        "globals": "^17.12.0",
        "nodemon": "^3.1.14",
        "supertest": "^7.2.2",
        "vitest": "^5.0.1",
        "yaml": "^2.9.1"
    },
    "engines": {
        "node": ">=22"
    },
    "overrides": {
        "uuid": "^14.0.2"
    },
    "allowScripts": {
        "@firebase/util@1.15.1": true,
        "bcrypt@6.0.0": true,
        "protobufjs@7.6.6": true
    }
}
