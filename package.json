{
    "name": "mirailink-backend",
    "version": "2.0.0",
    "description": "The official mirailink backend",
    "main": "./src/server.js",
    "scripts": {
        "dev": "cross-env NODE_ENV=development nodemon --env-file=.env src/server.js",
        "start": "cross-env NODE_ENV=production node --env-file=.env src/server.js",
        "build": "node --check src/server.js",
        "test": "vitest run",
        "lint": "eslint .",
        "test:unit": "vitest run tests/unit",
        "test:integration": "vitest run tests/integration",
        "test:database": "vitest run tests/database",
        "test:coverage": "vitest run --coverage",
        "lint:fix": "eslint . --fix",
        "check:routes": "node scripts/check-openapi-routes.js",
        "check": "npm run lint && npm run test:coverage && npm run check:routes"
    },
    "keywords": [
        "mirailink",
        "backend",
        "chat",
        "database",
        "social-media"
    ],
    "author": "FeryaelJustice",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "compression": "^1.8.1",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "express-rate-limit": "^8.5.2",
        "firebase-admin": "^14.1.0",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.2.0",
        "nodemailer": "^9.0.3",
        "pg": "^8.22.0",
        "speakeasy": "^2.0.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@vitest/coverage-v8": "^4.1.10",
        "cross-env": "^10.1.0",
        "eslint": "^10.7.0",
        "globals": "^17.7.0",
        "nodemon": "^3.1.14",
        "supertest": "^7.2.2",
        "vitest": "^4.1.10",
        "yaml": "^2.9.0"
    },
    "engines": {
        "node": ">=22"
    },
    "overrides": {
        "uuid": "^11.1.1"
    }
}
